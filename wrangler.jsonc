// Publicación en Cloudflare como Worker con assets estáticos.
//
// No es un proyecto de Pages: Cloudflare está integrando Pages dentro de Workers y los sitios
// estáticos nuevos se crean así. Para el sitio no cambia nada (se sirven los mismos archivos de
// dist/, con el mismo _headers), pero sí cambia el comando de publicación: `wrangler deploy` en
// lugar de `wrangler pages deploy`.
//
// Desde la v4.8.0 sí hay `main`: un script que sirve los mismos archivos y cuenta la visita. Ver
// worker/index.ts, que empieza explicando lo que NO hace.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visit-zibata",
  "compatibility_date": "2026-10-04",
  "main": "./worker/index.ts",
  "observability": { "enabled": true },
  /*
   * Sin `workers.dev`. Ahí el Worker se sirve en un nombre de host que no es el dominio, así que no
   * lo cubren ni la regla de Cloudflare Access del panel ni la de límite de peticiones del alta de
   * cuentas. Es una puerta de atrás a todo lo que hay detrás de las dos.
   */
  "workers_dev": false,
  /*
   * Los dos identificadores de la aplicación de Cloudflare Access que protege el panel. No son
   * secretos (el dominio del equipo sale en la URL de inicio de sesión y la etiqueta AUD identifica
   * la aplicación, como un `client_id`), así que van versionados.
   *
   * **Vacíos, el panel está cerrado.** Es deliberado: un despliegue a medias deja fuera a todo el
   * mundo en vez de publicar los números. Ver docs/DESPLIEGUE.md para de dónde salen.
   *
   * La etiqueta AUD lleva `gitleaks:allow` porque es 64 caracteres hexadecimales al lado de una
   * clave que contiene "ACCESS", y la regla `generic-api-key` la toma por una credencial. No lo es:
   * identifica la aplicación, no autoriza nada, y quien entra lo decide la política de Access. La
   * marca va en esta línea y no en un `.gitleaksignore` para que la razón se lea donde está el
   * valor, y porque una huella de `.gitleaksignore` caduca en cuanto la línea se mueve.
   */
  "vars": {
    "ACCESS_TEAM": "aurariola.cloudflareaccess.com",
    "ACCESS_AUD": "1d34898158a68d5bcc95ca810e155f7b045e8f93701a9ec607d5c09a97bcc265" // gitleaks:allow
  },
  /*
   * La base de visitas. El `database_id` no es un secreto: identifica la base, no da acceso a ella,
   * y por eso va versionado. Si falta o el enlace no existe, el sitio funciona igual y no se cuenta
   * nada (worker/index.ts lo comprueba).
   *
   * El nombre del enlace es `ANALITICA` y tiene que coincidir con lo que lee el Worker. Ojo con
   * `wrangler d1 create`: si se le deja escribir la configuración, añade **otra** entrada con un
   * nombre derivado del de la base y deja esta sin tocar, así que el Worker no encuentra nada.
   *
   * Sin `remote`: `wrangler dev` usa una base local y no ensucia las visitas de verdad. Esa opción
   * también la ofrece el asistente de creación, y aceptarla hace que probar en local escriba en
   * producción.
   */
  "d1_databases": [
    {
      "binding": "ANALITICA",
      "database_name": "visit-zibata-analitica",
      "database_id": "b24fe264-0bb4-47fc-bac5-091ce9459669"
    }
  ],
  /*
   * El aviso diario de sugerencias (ver worker/correo.ts). El destino es una dirección del dominio,
   * no el buzón personal: Email Routing la reenvía a su destino verificado, así que el correo de
   * quien mantiene la guía no aparece en un repositorio público. El enlace solo puede mandar a esa
   * dirección, y a ninguna otra.
   */
  "send_email": [
    {
      "name": "CORREO",
      "destination_address": "avisos@visitzibata.com"
    }
  ],
  /*
   * Las 15:00 UTC son las 9:00 en Zibatá (America/Mexico_City, UTC-6). Una vez al día y no más: el
   * resumen incluye todas las que sigan sin atender, así que repetirlo cada hora no añade nada.
   */
  "triggers": {
    "crons": ["0 15 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    /*
     * El Worker corre **solo** en las rutas de página, y por eso van enumeradas una a una en vez de
     * poner `true`. Con `true` cada tesela, cada imagen y cada archivo de `assets/` sería una
     * invocación facturada, y son cientos por visita; así son quince patrones y ni un archivo
     * estático pasa por el código.
     *
     * Es una lista blanca a propósito: si mañana aparece un tipo de ruta nuevo, no se contará hasta
     * que se añada aquí. Preferible a que se cuele lo que no toca.
     */
    "run_worker_first": [
      "/api/*",
      "/",
      "/lugar/*",
      "/zona/*",
      "/categoria/*",
      "/info/*",
      "/es",
      "/es/",
      "/es/lugar/*",
      "/es/zona/*",
      "/es/categoria/*",
      "/es/info/*",
      "/en",
      "/en/",
      "/en/place/*",
      "/en/area/*",
      "/en/category/*",
      "/en/info/*"
    ],
    // Una ruta inexistente devuelve el 404.html que genera el build, no la portada. Un *fallback*
    // tipo SPA convertiría cualquier error de tecleo en un 200 y Google indexaría basura; desde que
    // el enrutado salió del hash (v4.6.0) eso pasa de verdad. Hay pruebas E2E que lo comprueban.
    "not_found_handling": "404-page"
  }
}
