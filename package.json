{
  "name": "visit-zibata",
  "private": true,
  "license": "MIT",
  "version": "4.26.0",
  "description": "Guía interactiva 3D de Zibatá, Querétaro. Sitio estático, sin backend.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "worker:dev": "wrangler dev --var PANEL_ABIERTO:si",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:seo": "vitest run scripts/build && playwright test seo-regresion metadatos fragmentos sin-javascript --project=desktop",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "data:validate": "node scripts/data/validate-data.ts",
    "data:import": "node scripts/data/import-csv.ts",
    "analitica:crear": "wrangler d1 create visit-zibata-analitica",
    "analitica:esquema": "wrangler d1 execute visit-zibata-analitica --remote --file=worker/esquema.sql",
    "analitica:ver": "node scripts/analitica/ver.ts",
    "map:fetch": "npm run map:fetch:osm && npm run map:fetch:buildings && npm run map:fetch:trees",
    "map:fetch:osm": "node scripts/map/fetch-osm.ts",
    "map:fetch:buildings": "node scripts/map/fetch-overture.ts",
    "map:fetch:trees": "node scripts/map/fetch-landcover.ts",
    "map:fetch:realismo": "node scripts/map/realismo/fetch-realismo.ts",
    "map:build": "node scripts/map/build-map.ts",
    "map:build:realismo": "node scripts/map/realismo/build-realismo.ts",
    "map:build:mallas": "node scripts/map/realismo/build-mallas.ts",
    "map:masterplan": "node scripts/map/build-masterplan.ts",
    "map:georef": "node scripts/map/georef-plano.ts",
    "map:suggest-plaza": "node scripts/map/suggest-plaza.ts",
    "images:optimize": "node scripts/images/optimize-images.ts",
    "images:og": "node scripts/images/generate-og-image.ts",
    "images:marca": "node scripts/images/generate-brand-images.ts",
    "images:icons": "node scripts/images/generate-icons.ts",
    "perf:budget": "node scripts/perf/check-bundle.ts"
  },
  "dependencies": {
    "@fontsource-variable/special-gothic": "5.3.0",
    "@fontsource/kode-mono": "5.3.0",
    "@fontsource/special-gothic": "5.3.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.13",
    "@duckdb/node-api": "^1.5.5-r.5",
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/vt-pbf": "^4.3.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "earcut": "3.2.4",
    "geotiff": "3.0.5",
    "jsdom": "^30.1.3",
    "papaparse": "^5.7.0",
    "pmtiles": "^4.5.0",
    "proj4": "2.22.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "4.147.0"
  }
}
